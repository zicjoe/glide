# Backend server values. Never commit real secrets.
PORT=8787
HOST=0.0.0.0

# Supabase server access.
# Use the service role key on your local backend only. Do not expose this to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canton JSON Ledger API.
# Local sandbox tutorial default is often http://localhost:7575 when JSON API is enabled.
CANTON_JSON_API_URL=http://localhost:7575
CANTON_USER_ID=glide-backend
CANTON_AUTH_TOKEN=
CANTON_API_KEY=

# Real Daml parties hosted by your local Canton participant or DevNet participant.
CANTON_BUSINESS_PARTY=Business::your-real-party-id
CANTON_SETTLEMENT_OPERATOR_PARTY=SettlementOperator::your-real-party-id

# Package-name template id for the Glide DAR after deployment.
CANTON_INVOICE_TEMPLATE_ID=glide-workflow:Glide.Workflow.InvoiceWorkflow:InvoiceWorkflow
