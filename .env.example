# Frontend data mode
# local: browser local storage only
# supabase: hosted Supabase Postgres through @supabase/supabase-js
# http: local Node API shell on http://localhost:8787
VITE_GLIDE_API_MODE=local
VITE_GLIDE_API_BASE_URL=http://localhost:8787

# Supabase mode
# Create .env.local and add your real values from Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API shell
PORT=8787
HOST=0.0.0.0

# Canton workflow configuration
# These values are optional until you wire the ledger adapter.
VITE_CANTON_ENVIRONMENT=DevNet
VITE_CANTON_LEDGER_API_URL=
VITE_CANTON_PARTICIPANT_ID=
VITE_CANTON_WORKFLOW_PACKAGE=glide-workflow
VITE_CANTON_WORKFLOW_MODULE=Glide.Workflow.InvoiceWorkflow

# Canton bridge configuration
# Use mock for hackathon/devnet UI sync without live ledger submission.
VITE_CANTON_SYNC_MODE=mock
VITE_CANTON_ENVIRONMENT=DevNet
VITE_CANTON_LEDGER_API_URL=
VITE_CANTON_PARTICIPANT_ID=
VITE_CANTON_WORKFLOW_PACKAGE=glide-workflow
VITE_CANTON_WORKFLOW_MODULE=Glide.Workflow.InvoiceWorkflow
