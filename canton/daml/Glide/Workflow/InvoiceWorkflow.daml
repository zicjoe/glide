module Glide.Workflow.InvoiceWorkflow where

import DA.Time (Time)

-- Glide's Canton workflow model.
-- This contract records invoice, payment, settlement, fulfillment, and audit state.
-- Token movement for CC and USDCx should be wired through Canton token contracts/adapters later.

data AssetType = CC | USDCx
  deriving (Eq, Show)

data InvoiceStatus
  = Draft
  | Issued
  | PaymentPending
  | PaymentConfirmed
  | SettlementPending
  | Settled
  | Fulfilled
  | Cancelled
  | Disputed
  deriving (Eq, Show)

data ActorRole
  = Business
  | Payer
  | SettlementOperator
  | Observer
  deriving (Eq, Show)

data WorkflowEvent = WorkflowEvent with
    action : Text
    actor : Party
    actorRole : ActorRole
    previousStatus : Optional InvoiceStatus
    newStatus : InvoiceStatus
    timestamp : Time
  deriving (Eq, Show)

template InvoiceWorkflow
  with
    invoiceId : Text
    business : Party
    payer : Party
    settlementOperator : Party
    auditObserver : Party
    title : Text
    customerName : Text
    amount : Decimal
    asset : AssetType
    settlementDestination : Text
    dueDate : Time
    description : Text
    status : InvoiceStatus
    auditTrail : [WorkflowEvent]
  where
    signatory business
    observer payer, settlementOperator, auditObserver

    ensure amount > 0.0

    choice Issue : ContractId InvoiceWorkflow
      controller business
      do
        now <- getTime
        assertMsg "Only draft invoices can be issued" (status == Draft)
        create this with
          status = PaymentPending
          auditTrail = auditTrail ++
            [ WorkflowEvent with
                action = "Invoice Issued"
                actor = business
                actorRole = Business
                previousStatus = Some Draft
                newStatus = Issued
                timestamp = now
            , WorkflowEvent with
                action = "Payment Request Generated"
                actor = business
                actorRole = Business
                previousStatus = Some Issued
                newStatus = PaymentPending
                timestamp = now
            ]

    choice ConfirmPayment : ContractId InvoiceWorkflow
      controller payer
      do
        now <- getTime
        assertMsg "Payment can only be confirmed from issued or payment pending state" (status == Issued || status == PaymentPending)
        create this with
          status = PaymentConfirmed
          auditTrail = auditTrail ++
            [ WorkflowEvent with
                action = "Payment Confirmed"
                actor = payer
                actorRole = Payer
                previousStatus = Some status
                newStatus = PaymentConfirmed
                timestamp = now
            ]

    choice RouteSettlement : ContractId InvoiceWorkflow
      controller settlementOperator
      do
        now <- getTime
        assertMsg "Settlement can only be routed after payment confirmation" (status == PaymentConfirmed)
        create this with
          status = SettlementPending
          auditTrail = auditTrail ++
            [ WorkflowEvent with
                action = "Settlement Routed"
                actor = settlementOperator
                actorRole = SettlementOperator
                previousStatus = Some PaymentConfirmed
                newStatus = SettlementPending
                timestamp = now
            ]

    choice MarkSettled : ContractId InvoiceWorkflow
      controller settlementOperator
      do
        now <- getTime
        assertMsg "Settlement can only be completed after routing" (status == SettlementPending)
        create this with
          status = Settled
          auditTrail = auditTrail ++
            [ WorkflowEvent with
                action = "Settlement Confirmed"
                actor = settlementOperator
                actorRole = SettlementOperator
                previousStatus = Some SettlementPending
                newStatus = Settled
                timestamp = now
            ]

    choice MarkFulfilled : ContractId InvoiceWorkflow
      controller business
      do
        now <- getTime
        assertMsg "Fulfillment can only be recorded after settlement" (status == Settled)
        create this with
          status = Fulfilled
          auditTrail = auditTrail ++
            [ WorkflowEvent with
                action = "Fulfillment Confirmed"
                actor = business
                actorRole = Business
                previousStatus = Some Settled
                newStatus = Fulfilled
                timestamp = now
            ]

    choice CancelInvoice : ContractId InvoiceWorkflow
      controller business
      do
        now <- getTime
        assertMsg "Completed, cancelled, or disputed invoices cannot be cancelled" (status /= Fulfilled && status /= Cancelled && status /= Disputed)
        create this with
          status = Cancelled
          auditTrail = auditTrail ++
            [ WorkflowEvent with
                action = "Invoice Cancelled"
                actor = business
                actorRole = Business
                previousStatus = Some status
                newStatus = Cancelled
                timestamp = now
            ]

    choice DisputeInvoice : ContractId InvoiceWorkflow
      controller payer
      do
        now <- getTime
        assertMsg "Completed, cancelled, or disputed invoices cannot be disputed" (status /= Fulfilled && status /= Cancelled && status /= Disputed)
        create this with
          status = Disputed
          auditTrail = auditTrail ++
            [ WorkflowEvent with
                action = "Invoice Disputed"
                actor = payer
                actorRole = Payer
                previousStatus = Some status
                newStatus = Disputed
                timestamp = now
            ]
