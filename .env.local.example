# Copy this file to .env.local and paste real values from Supabase Dashboard → Project Settings → API.
# Never commit your real .env.local file.

VITE_GLIDE_API_MODE=supabase
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional Canton configuration for the next integration step.
VITE_CANTON_ENVIRONMENT=DevNet
VITE_CANTON_LEDGER_API_URL=
VITE_CANTON_PARTICIPANT_ID=
VITE_CANTON_WORKFLOW_PACKAGE=glide-workflow
VITE_CANTON_WORKFLOW_MODULE=Glide.Workflow.InvoiceWorkflow
